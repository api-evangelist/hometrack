              {
                "disabled": false,
                "description": "(Required) Token based authorization header. Example value: <br/>\n<div style='font-family: \"Courier New\", Courier, monospace;'>Token token=\"652da107-bb66-4886-9f73-d8d4a3243eb7\"</div>",
                "key": "Authorization",
                "value": "string"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"property\": {\n    \"address\": \"141 Upper Hill street\",\n    \"postcode\": \"L8 8EN\",\n    \"propertyType\": \"end terrace house\",\n    \"bedrooms\": 4,\n    \"receptions\": 1,\n    \"reference\": \"CREF55555\"\n  }\n}",
